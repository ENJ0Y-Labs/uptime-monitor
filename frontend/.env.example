# Local development only. Copy to .env.local and use the same token from worker/.dev.vars.
# These names intentionally do NOT use the VITE_ prefix, so Vite keeps them server-side.
APIMON_API_ORIGIN=http://127.0.0.1:8787
APIMON_API_TOKEN=replace-with-the-local-worker-token

# Production only: set this public API URL in your frontend hosting environment.
# VITE_APIMON_API_BASE_URL=https://your-protected-worker-domain.example.com